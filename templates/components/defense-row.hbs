{{! Defense Row Component }}
{{! @param attribute - Nome do atributo (STRENGTH, DEXTERITY, etc) }}
{{! @param attributeKey - Chave para o system (strength, dexterity, etc) }}
<tr>
  <td>{{attribute}}</td>
  <td>
    <select
      class="proficiency-select"
      name="system.attributes.{{attributeKey}}.proficiency"
    >
      <option value="untrained" {{#if (eq (lookup (lookup (lookup system 'attributes') attributeKey) 'proficiency') 'untrained')}}selected{{/if}}>Untrained</option>
      <option value="trained" {{#if (eq (lookup (lookup (lookup system 'attributes') attributeKey) 'proficiency') 'trained')}}selected{{/if}}>Trained</option>
      <option value="expert" {{#if (eq (lookup (lookup (lookup system 'attributes') attributeKey) 'proficiency') 'expert')}}selected{{/if}}>Expert</option>
      <option value="master" {{#if (eq (lookup (lookup (lookup system 'attributes') attributeKey) 'proficiency') 'master')}}selected{{/if}}>Master</option>
      <option value="legendary" {{#if (eq (lookup (lookup (lookup system 'attributes') attributeKey) 'proficiency') 'legendary')}}selected{{/if}}>Legendary</option>
    </select>
  </td>
  <td><input
      type="number"
      name="system.attributes.{{attributeKey}}.bonus"
      value="{{lookup (lookup (lookup system 'attributes') attributeKey) 'bonus'}}"
      placeholder="Bonus"
    /></td>
  <td><input
      type="number"
      name="system.attributes.{{attributeKey}}.defenseDC"
      value="{{lookup (lookup system 'attributes') attributeKey 'defenseDC'}}"
      placeholder="DC"
    /></td>
  <td><input
      type="number"
      name="system.attributes.{{attributeKey}}.item"
      value="{{lookup (lookup system 'attributes') attributeKey 'item'}}"
    /></td>
</tr>