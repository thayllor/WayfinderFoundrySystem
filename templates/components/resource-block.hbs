{{!-- Resource Block Component --}}
{{!-- @param title - Título do bloco --}}
{{!-- @param blockClass - Classes CSS adicionais (ex: stamina-block) --}}
{{!-- @param contentClass - Classes para o content (ex: stamina-layout) --}}
<div class="resource-block {{blockClass}}">
  {{#if title}}
    <h4>{{title}}</h4>
  {{/if}}
  <div class="resource-block-content {{contentClass}}">
    {{> @partial-block}}
  </div>
</div>
