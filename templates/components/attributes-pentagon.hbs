{{! Attributes Pentagon Component }}
<div class="attributes-pentagon">

  <img
    src="systems/wayfinder/images/marca_dagua_atributos.png"
    alt="Marca d'Água Atribut os"
    class="pentagon-background-img"
  />
  <div class="pentagon-attributes-container">
    {{#each system.attributes as |attribute key|}}
      <div class="pentagon-attribute" data-attribute-key="{{key}}">
        <div class="attribute-name" data-attribute-key="{{key}}">
          <svg
            class="attribute-roll-badge"
            viewBox="0 0 120 40"
            aria-hidden="true"
            role="img"
            xmlns:xlink="http://www.w3.org/1999/xlink"
          >
            <defs>
              <!-- Slightly lower, wider arc so the text sits below the top edge -->
              <path
                id="arc-{{key}}"
                class="wf-arc-path"
                d="M10,30 A50,50 0 0,1 110,30"
                aria-hidden="true"
              />
            </defs>
            <text
              text-anchor="middle"
              style="fill:var(--color-text-primary,#e6e6e6);font-family:var(--wf-font-sans);font-weight:700;font-size:16px;"
              dy="4"
            >
              <textPath
                href="#arc-{{key}}"
                xlink:href="#arc-{{key}}"
                startOffset="50%"
              >{{key}}</textPath>
            </text>
          </svg>
        </div>
        <div class="attribute-pentagon-box">
          <div class="attribute-value-container">
            <div class="attribute-value-box">
              <input
                class="attribute-value"
                type="number"
                name="system.attributes.{{key}}.value"
                value="{{default attribute.value 0}}"
              />
            </div>
            <div class="attribute-defence-box">
              <span class="attribute-defence">
                <span class="defense-total">{{defenseTotal
                    key
                    system.attributes
                  }}</span>
              </span>
            </div>
            <span class="defense-total">{{defenseTotal
                key
                system.attributes
              }}</span>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>