{{! Attribute Defenses Table Component }}
<div class="resources-section">
  <h3>Attribute Defenses</h3>
  <table class="defenses-table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Proficiency</th>
        <th>Status</th>
        <th>Circun</th>
        <th>Item</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {{! STRENGTH }}
      <tr>
        <td>STRENGTH</td>
        <td>
          <select
            class="proficiency-select"
            name="system.attributes.strength.proficiency"
          >
            <option value="untrained" {{#if (eq system.attributes.strength.proficiency 'untrained')}}selected{{/if}}{{#if (eq system.attributes.strength.proficiency 'Untrained')}}selected{{/if}}>Untrained</option>
            <option value="trained" {{#if (eq system.attributes.strength.proficiency 'trained')}}selected{{/if}}{{#if (eq system.attributes.strength.proficiency 'Trained')}}selected{{/if}}>Trained</option>
            <option value="expert" {{#if (eq system.attributes.strength.proficiency 'expert')}}selected{{/if}}{{#if (eq system.attributes.strength.proficiency 'Expert')}}selected{{/if}}>Expert</option>
            <option value="master" {{#if (eq system.attributes.strength.proficiency 'master')}}selected{{/if}}{{#if (eq system.attributes.strength.proficiency 'Master')}}selected{{/if}}>Master</option>
            <option value="legendary" {{#if (eq system.attributes.strength.proficiency 'legendary')}}selected{{/if}}{{#if (eq system.attributes.strength.proficiency 'Legendary')}}selected{{/if}}>Legendary</option>
          </select>
        </td>
        <td><input
            type="number"
            name="system.attributes.strength.status"
            value="{{toInt system.attributes.strength.status}}"
            placeholder="Status"
          /></td>
        <td><input
            type="number"
            name="system.attributes.strength.circun"
            value="{{toInt system.attributes.strength.circun}}"
            placeholder="Circun"
          /></td>
        <td><input
            type="number"
            name="system.attributes.strength.item"
            value="{{toInt system.attributes.strength.item}}"
            placeholder="Item"
          /></td>
        <td><div class="attribute-total">{{toInt system.attributes.strength.total}}</div></td>
      </tr>
