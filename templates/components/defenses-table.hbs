{{! Attribute Defenses Table Component }}
<div class="resources-section">
  <h3>Attribute Defenses</h3>
  <table class="defenses-table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Proficiency</th>
        <th>Bonus</th>
        <th>Defense DC</th>
        <th>Item</th>
      </tr>
    </thead>
    <tbody>
      {{! STRENGTH }}
      <tr>
        <td>STRENGTH</td>
        <td>
          <select
            class="proficiency-select"
            name="system.attributes.strength.proficiency"
          >
            <option value="Untrained" selected>Untrained</option>
            <option value="Trained">Trained</option>
            <option value="Expert">Expert</option>
            <option value="Master">Master</option>
            <option value="Legendary">Legendary</option>
          </select>
        </td>
        <td><input
            type="number"
            name="system.attributes.strength.bonus"
            value="{{toInt system.attributes.strength.bonus}}"
            placeholder="Bonus"
          /></td>
        <td><input
            type="number"
            name="system.attributes.strength.defenseDC"
            value="{{toInt system.attributes.strength.defenseDC}}"
            placeholder="DC"
          /></td>
        <td><input
            type="number"
            name="system.attributes.strength.item"
            value="{{toInt system.attributes.strength.item}}"
          /></td>
      </tr>
      {{! DEXTERITY }}
