<form class="{{cssClasses}}" autocomplete="off">
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{item.img}}"
      data-edit="img"
      title="{{item.name}}"
    />
    <section class="header-fields">
      <div class="header-top">
        <h1 class="charname">
          <input
            name="name"
            type="text"
            value="{{item.name}}"
            placeholder="Nome do Talent"
          />
        </h1>
        <div class="talent-type-badge {{system.talentType}}">
          <i class="fas fa-{{#if (eq system.talentType "Basic")}}circle{{else if (eq system.talentType "General")}}star{{else if (eq system.talentType "Ancestry")}}dna{{else if (eq system.talentType "Spell")}}hat-wizard{{else}}shield-alt{{/if}}"></i>
          <span>{{system.talentType}}</span>
        </div>
      </div>
      <div class="talent-metadata-card">
        <div class="metadata-item">
          <div class="metadata-icon">
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="metadata-content">
            <label>Nível</label>
            <input
              type="number"
              name="system.level"
              value="{{system.level}}"
              min="1"
              max="20"
              class="talent-level-input"
            />
          </div>
        </div>
        <div class="metadata-item">
          <div class="metadata-icon type-icon">
            <i class="fas fa-tag"></i>
          </div>
          <div class="metadata-content">
            <label>Tipo</label>
            <select name="system.talentType" class="talent-type-select">
              <option value="Basic" {{#if (eq system.talentType "Basic")}}selected{{/if}}>Basic</option>
              <option value="General" {{#if (eq system.talentType "General")}}selected{{/if}}>General</option>
              <option value="Ancestry" {{#if (eq system.talentType "Ancestry")}}selected{{/if}}>Ancestry</option>
              <option value="Class" {{#if (eq system.talentType "Class")}}selected{{/if}}>Class</option>
              <option value="Spell" {{#if (eq system.talentType "Spell")}}selected{{/if}}>Spell</option>
            </select>
          </div>
        </div>
      </div>
    </section>
  </header>

  {{! Sheet Body }}
  <section class="sheet-body">
    {{! Traits Section }}
    {{#if traitsResolved.length}}
      <div class="trait-chip-row">
        <span class="trait-chip-label">Traits:</span>
        {{#each traitsResolved as |trait|}}
          <div
            class="trait-chip"
            style="background-color: {{trait.color}};"
            title="{{trait.name}}"
          >
            <span class="trait-chip-name">{{trait.name}}</span>
            {{#if @root.editable}}
              <button
                type="button"
                class="trait-chip-remove"
                data-uuid="{{trait.uuid}}"
                title="Remover trait"
              >×</button>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{/if}}

    {{! Description Section }}
    <div class="talent-description-section">
      <div class="description-card">
        <div class="description-card-header">
          <div class="description-card-title"><i class="fas fa-file-alt"></i> Descrição do Talent</div>
          <div class="description-card-hint">Use formatação rica para narrar o talento.</div>
        </div>
        {{textoEstilizado
          name="system.description"
          value=system.description
          label=""
          editable=editable
        }}
      </div>
    </div>

    {{! Effects Section }}
    <div class="talent-effects-section">
      {{! Active Effects }}
      <div class="effects-category active-effects-category">
        <h3 class="effects-title active-title" style="color: var(--wayfinder-primary-dark);">
          <i class="fas fa-bolt"></i>
          Efeitos Ativos
          {{#if activeEffects.length}}
            <span class="effect-count">{{activeEffects.length}}</span>
          {{/if}}
        </h3>

        {{#if activeEffects.length}}
          <div class="effects-list">
            {{#each activeEffects as |effect idx|}}
              {{{collapsibleEffect effect=effect idx=idx}}}
              {{#if @root.editable}}
                <div class="effect-item-actions">
                  <button
                    type="button"
                    class="remove-effect-btn"
                    data-uuid="{{effect.uuid}}"
                    title="Remover efeito"
                  >
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              {{/if}}
            {{/each}}
          </div>
        {{else}}
          <p class="empty-message">
            <i class="fas fa-info-circle"></i>
            Nenhum efeito ativo. Arraste efeitos ativos aqui para adicionar.
          </p>
        {{/if}}
      </div>

      {{! Passive Effects }}
      <div class="effects-category passive-effects-category">
        <h3 class="effects-title passive-title" style="color: var(--wayfinder-primary-dark);">
          <i class="fas fa-shield-alt"></i>
          Efeitos Passivos
          {{#if passiveEffects.length}}
            <span class="effect-count">{{passiveEffects.length}}</span>
          {{/if}}
        </h3>

        {{#if passiveEffects.length}}
          <div class="effects-list">
            {{#each passiveEffects as |effect idx|}}
              {{{collapsibleEffect effect=effect idx=idx}}}
              {{#if @root.editable}}
                <div class="effect-item-actions">
                  <button
                    type="button"
                    class="remove-effect-btn"
                    data-uuid="{{effect.uuid}}"
                    title="Remover efeito"
                  >
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              {{/if}}
            {{/each}}
          </div>
        {{else}}
          <p class="empty-message">
            <i class="fas fa-info-circle"></i>
            Nenhum efeito passivo. Arraste efeitos passivos aqui para adicionar.
          </p>
        {{/if}}
      </div>
    </div>
  </section>
</form>