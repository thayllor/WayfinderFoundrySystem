<form class="{{cssClasses}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <section class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Nome do Efeito Passivo"/>
      </h1>
    </section>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item active" data-tab="details">Detalhes</a>
    <a class="item" data-tab="effects">Active Modifiers</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">     {{#if traitsResolved.length}}
     <div class="trait-chip-row">
       <span class="trait-chip-label">Traits:</span>
       {{#each traitsResolved as |trait|}}
        <div class="trait-chip" style="background: {{trait.color}}; color: {{trait.textColor}};" title="{{trait.name}}">
          <span class="trait-chip-name">{{trait.name}}</span>
         </div>
       {{/each}}
     </div>
     {{/if}}
    {{!-- DETAILS TAB --}}
    <div class="tab active" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>Nome</label>
        <input type="text" name="name" value="{{item.name}}" class="effect-input"/>
      </div>

      <div class="description-card">
        <div class="description-card-header">
          <div class="description-card-title"><i class="fas fa-file-alt"></i> Efeito</div>
        </div>
        {{textoEstilizado
          name="system.effect"
          value=system.effect
          label=""
          editable=editable
        }}
      </div>

      <div class="form-group checkbox">
        <label>Efeito Permanente?</label>
        <input type="checkbox" name="system.isPermanent" {{#if system.isPermanent}}checked{{/if}}/>
        <span style="font-size: 12px; color: #666;">Se não marcado, pode ser ativado/desativado</span>
      </div>
    </div>

    {{!-- MODIFIERS TAB --}}
    <div class="tab" data-group="primary" data-tab="effects">
      <p style="padding: 10px; color: #666; font-size: 12px;">Here you can add permanent modifiers that apply while the effect is active.</p>

      <div class="modifiers-section">
        <h3>Applied Active Modifiers</h3>
        <p style="color: #999; font-size: 12px;">Add modifiers that this passive effect grants while present.</p>
        <div class="modifiers-container">
          {{#if system.modifiers}}
            <div class="modifiers-card">
              {{#each system.modifiers as |m idx|}}
                <div class="modifier-card" data-idx="{{idx}}">
                  <div class="modifier-line">
                    <div class="modifier-origin" title="{{#if flags.wayfinder.sourceItemName}}Item: {{flags.wayfinder.sourceItemName}}{{else if flags.wayfinder.sourceTalentName}}Talento: {{flags.wayfinder.sourceTalentName}}{{else}}Ficha{{/if}}">{{#if flags.wayfinder.sourceItemName}}Item: {{flags.wayfinder.sourceItemName}}{{else if flags.wayfinder.sourceTalentName}}Talento: {{flags.wayfinder.sourceTalentName}}{{else}}Ficha{{/if}}</div>
                    <div class="modifier-info">
                      <div class="modifier-name">{{m.name}}</div>
                      <div class="modifier-target">→ {{m.targetPath}}</div>
                    </div>
                    <div class="modifier-value">{{m.value}}</div>
                    <div class="modifier-actions">
                      <button type="button" class="edit-modifier" data-idx="{{idx}}">Editar</button>
                      <button type="button" class="delete-modifier" data-idx="{{idx}}">🗑</button>
                    </div>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="modifiers-empty" style="color:#999; padding:8px">Nenhum modifier definido.</div>
          {{/if}}
        </div>
        <button type="button" class="add-modifier-btn">+ Add Modifier</button>
      </div>
    </div>
  </section>
</form>
