<form class="wayfinder flexcol" autocomplete="off">
  {{!-- CHARACTER INFO ROW --}}
  {{> "systems/wayfinder/templates/components/character-info.hbs"}}
  {{!-- Resources Row --}}
  {{> "systems/wayfinder/templates/components/top-resources-row.hbs"}}

  <div class="attributes-resources-horizontal">
    {{!-- ATTRIBUTES PENTAGON (esquerda) --}}
    {{> "systems/wayfinder/templates/components/attributes-pentagon.hbs"}}

    {{!-- RESOURCES (direita) --}}
    {{> "systems/wayfinder/templates/components/defenses-table.hbs"}}
  </div>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item active" data-tab="skills" data-icon="d20">Perícias</a>
    <a class="item" data-tab="actions" data-icon="actions">Ações</a>
    <a class="item" data-tab="modifiers" data-icon="wf-plus-or-minus">Active Modifiers</a>
    <a class="item" data-tab="talents" data-icon="star">Talentos</a>
    <a class="item" data-tab="spells" data-icon="magic">Magia e Conjuração</a>
    <a class="item" data-tab="notes" data-icon="open-book">Anotações</a>
    <a class="item" data-tab="resources" data-icon="items">Inventário</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- SKILLS TAB --}}
    <div class="tab" data-group="primary" data-tab="skills">
      {{> "systems/wayfinder/templates/actor/parts/actor-skills-tab.hbs"}}
    </div>

    {{!-- ACTIONS TAB (Efeitos) --}}
    <div class="tab" data-group="primary" data-tab="actions">
      {{> "systems/wayfinder/templates/actor/parts/actor-effects-tab.hbs"}}
    </div>

    {{!-- MODIFIERS TAB --}}
    <div class="tab" data-group="primary" data-tab="modifiers">
      {{> "systems/wayfinder/templates/actor/parts/actor-modifiers-tab.hbs"}}
    </div>

    {{!-- TALENTS TAB --}}
    <div class="tab" data-group="primary" data-tab="talents">
      {{> "systems/wayfinder/templates/actor/parts/actor-talents-tab.hbs"}}
    </div>

    {{!-- SPELLS TAB --}}
    <div class="tab" data-group="primary" data-tab="spells">
      {{> "systems/wayfinder/templates/actor/parts/actor-spells-tab.hbs"}}
    </div>

    {{!-- NOTES TAB --}}
    <div class="tab" data-group="primary" data-tab="notes">
      {{> "systems/wayfinder/templates/actor/parts/actor-notes-tab.hbs"}}
    </div>

    {{!-- RESOURCES TAB --}}
    <div class="tab" data-group="primary" data-tab="resources">
      {{> "systems/wayfinder/templates/actor/parts/actor-inventory-tab.hbs"}}
    </div>
  </section>
</form>
