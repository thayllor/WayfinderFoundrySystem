{{! TALENTS TAB CONTENT }}
<h2 class="tab-title tab-title-talents">Talentos</h2>
<div class="talents-section">
  {{! Basic Talents }}
  <div class="talent-type-category">
    <div class="talent-type-header" data-talent-type="Basic">
      <i class="fas fa-chevron-right talent-type-icon"></i>
      <div class="talent-type-badge Basic">
        <i class="fas fa-circle"></i>
        <span>Basic Talents</span>
      </div>
      {{#if talents.Basic.length}}
        <span class="talent-count">{{talents.Basic.length}}</span>
      {{/if}}
    </div>
    <div class="talent-type-content" style="display: block;">
      {{#if talents.Basic.length}}
        {{#each talents.Basic as |talent|}}
          <div class="talent-item" data-item-id="{{talent.id}}">
            <div class="talent-item-header" data-talent-id="{{talent.id}}">
              <i class="fas fa-chevron-right talent-item-icon"></i>
              <span class="talent-item-name">{{talent.name}}</span>
              <span class="talent-level-badge">Nv {{talent.system.level}}</span>
              {{#if @root.editable}}
                <button
                  type="button"
                  class="talent-edit-btn"
                  data-item-id="{{talent._id}}"
                  title="Editar talento"
                >
                  <i class="fas fa-edit"></i>
                </button>
                <button
                  type="button"
                  class="talent-delete-btn"
                  data-item-id="{{talent._id}}"
                  title="Remover talento"
                >
                  <i class="fas fa-trash"></i>
                </button>
              {{/if}}
            </div>
            <div class="talent-item-content" style="display: none;"></div>
          </div>
        {{/each}}
      {{else}}
        <p class="empty-message"><i class="fas fa-info-circle"></i>
          Nenhum talento Basic.</p>
      {{/if}}
    </div>
  </div>

