<h2 class="tab-title tab-title-actions">Efeitos</h2>

<div class="effects-container split-by-source">
  <div class="effects-source-column effects-source-items">
    <div class="effects-source-card">
      <h2 class="effects-source-title">Efeitos de Itens</h2>
      <div class="type-effects">

        <div class="effects-section">
          <h3 class="effects-subtitle">Ativos</h3>
          <div class="effects-list-wrapper">
            {{#if (gt itemActiveEffects.length 0)}}
              <div class="effects-collapsible-list">
                {{#each itemActiveEffects as |effect index|}}
                  {{{collapsibleEffect
                    effect=effect
                    idx=index
                    source="effects-tab"
                  }}}
                  {{#if @root.editable}}
                    <div class="effect-item-actions">
                      <button
                        type="button"
                        class="remove-effect-btn"
                        data-uuid="{{effect.uuid}}"
                        title="Remover efeito"
                      >
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  {{/if}}
                {{/each}}
              </div>
            {{else}}
              <p class="effects-empty">Nenhum efeito ativo vindo de itens.</p>
            {{/if}}
          </div>
        </div>

        <div class="effects-section">
          <h3 class="effects-subtitle">Passivos</h3>
          <div class="effects-list-wrapper">
            {{#if (gt itemPassiveEffects.length 0)}}
